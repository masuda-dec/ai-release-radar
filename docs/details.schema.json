{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Release detail v1",
  "type": "object",
  "required": [
    "change",
    "before",
    "after",
    "workflow",
    "benefit",
    "environment",
    "limitations",
    "schemaVersion",
    "mode",
    "basis",
    "inputHash",
    "steps",
    "commands",
    "community"
  ],
  "properties": {
    "change": {
      "type": "string",
      "minLength": 5,
      "maxLength": 1400
    },
    "before": {
      "type": "string",
      "minLength": 5,
      "maxLength": 1400
    },
    "after": {
      "type": "string",
      "minLength": 5,
      "maxLength": 1400
    },
    "workflow": {
      "type": "string",
      "minLength": 5,
      "maxLength": 1400
    },
    "benefit": {
      "type": "string",
      "minLength": 5,
      "maxLength": 1400
    },
    "environment": {
      "type": "string",
      "minLength": 5,
      "maxLength": 1400
    },
    "limitations": {
      "type": "string",
      "minLength": 5,
      "maxLength": 1400
    },
    "schemaVersion": {
      "const": 1
    },
    "mode": {
      "enum": [
        "rule",
        "ai",
        "editorial"
      ]
    },
    "basis": {
      "type": "string"
    },
    "inputHash": {
      "type": "string"
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "string",
        "minLength": 5,
        "maxLength": 900
      }
    },
    "commands": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": [
          "label",
          "platform",
          "command"
        ],
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1800
          },
          "platform": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1800
          },
          "command": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1800
          }
        }
      }
    },
    "community": {
      "type": "object",
      "required": [
        "status",
        "checkedAt",
        "searches",
        "sources"
      ],
      "properties": {
        "status": {
          "enum": [
            "not_searched",
            "none",
            "candidates",
            "reviewed"
          ]
        },
        "checkedAt": {
          "type": [
            "string",
            "null"
          ]
        },
        "searches": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "platform",
              "status"
            ],
            "properties": {
              "platform": {
                "type": "string"
              },
              "status": {
                "enum": [
                  "found",
                  "not_found",
                  "unavailable",
                  "not_searched",
                  "not_applicable"
                ]
              }
            }
          }
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "url",
              "title",
              "publishedAt",
              "platform",
              "kind",
              "summary",
              "relation",
              "verified"
            ],
            "properties": {
              "url": {
                "type": "string",
                "pattern": "^https://"
              },
              "publishedAt": {
                "type": "string"
              },
              "verified": {
                "type": "boolean"
              },
              "kind": {
                "enum": [
                  "user_report",
                  "developer_report",
                  "official_demo"
                ]
              }
            }
          }
        }
      }
    }
  }
}
